# Full override of systemd-user-sessions.service.
#
# Purpose: remove the network.target wait from the login/greeter chain so
# greetd (and getty) appear without waiting for the network. The vendor unit
# orders this service After=network.target, and greetd.service orders itself
# After=systemd-user-sessions.service (via plymouth-quit-wait.service), so the
# greeter was transitively blocked on wpa_supplicant/network.target at boot.
#
# Target unit: this is a FULL override of systemd-user-sessions.service, NOT a
# drop-in. Per systemd.unit(5), dependencies (After=, etc.) cannot be reset to
# an empty list, so drop-ins can only add dependencies, never remove them;
# removing network.target from After= requires overriding the entire unit.
#
# Staged install: configure-noctalia-greeter.sh installs this file to
# /etc/systemd/system/systemd-user-sessions.service. Nothing is restarted from
# inside the graphical session; the override takes effect on the next boot.
#
# Vendor-drift duty: because /etc fully masks the vendor unit, systemd package
# updates to /usr/lib/systemd/system/systemd-user-sessions.service will NOT
# propagate to this override. Re-diff this file against the vendor unit on
# major systemd updates and re-sync any vendor changes (keeping network.target
# removed).

[Unit]
Description=Permit User Sessions
Documentation=man:systemd-user-sessions.service(8)
After=remote-fs.target nss-user-lookup.target home.mount

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/systemd/systemd-user-sessions start
ExecStop=/usr/lib/systemd/systemd-user-sessions stop
