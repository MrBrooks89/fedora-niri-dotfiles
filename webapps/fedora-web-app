#!/usr/bin/env bash
set -Eeuo pipefail

# Create and manage Chromium app-mode launchers without evaluating user input.

readonly APP_PREFIX="fedora-web-app-"
readonly DESKTOP_COMMAND="fedora-web-app"

die() {
    printf 'ERROR: %s\n' "$*" >&2
    exit 2
}

notify_error() {
    local summary="$1"
    local body="$2"

    if command -v notify-send >/dev/null 2>&1; then
        notify-send --app-name="Web Apps" --urgency=normal "$summary" "$body" || true
    fi
    printf 'ERROR: %s: %s\n' "$summary" "$body" >&2
}

xdg_data_home() {
    if [[ -n "${XDG_DATA_HOME:-}" && "${XDG_DATA_HOME}" == /* ]]; then
        printf '%s\n' "$XDG_DATA_HOME"
    else
        printf '%s/.local/share\n' "$HOME"
    fi
}

readonly SELECTED_DATA_HOME="$(xdg_data_home)"
readonly INVOKING_UID="$(id -u)"
DATA_ROOT=""
CONFIG_DIR=""
APPLICATIONS_DIR=""
TEMP_DIR=""

usage() {
    cat <<'EOF'
Usage: fedora-web-app [command] [options]

Create and manage Chromium app-mode launchers under XDG_DATA_HOME.

Commands:
  add [--id ID] [--name NAME] [--url HTTPS_URL]
      Create or update a web app. With no options, prompts in a terminal.
  preset outlook
      Create or update the Outlook web app.
  launch --id ID
      Launch a managed app through Chromium on native Wayland.
  list
      List managed app IDs, names, and URLs.
  remove --id ID
      Remove a managed launcher and its metadata.
  --print-browser
      Print the Chromium executable selected for launch diagnostics.
  -h, --help
      Show this help.

Examples:
  fedora-web-app
  fedora-web-app add --name "Example Portal" --url https://portal.example.com/
  fedora-web-app add --id docs --name "Project Docs" --url https://docs.example.com/
  fedora-web-app preset outlook
  fedora-web-app list
  fedora-web-app remove --id docs
EOF
}

require_value() {
    local option="$1"
    local value="${2:-}"
    [[ -n "$value" ]] || die "$option requires a value."
}

valid_id() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]]
}

valid_name() {
    local pattern='^[A-Za-z0-9][A-Za-z0-9._ -]{0,62}$'
    [[ "$1" =~ $pattern ]]
}

valid_url() {
    local url="$1"
    local rest authority host port
    local printable_pattern='^[[:print:]]+$'

    [[ "$url" =~ ^https?:// ]] || return 1
    [[ "$url" =~ $printable_pattern && "$url" != *[[:space:]]* && "$url" != *\\* ]] || return 1

    if [[ "$url" == https://* ]]; then
        rest="${url#https://}"
    else
        rest="${url#http://}"
    fi
    authority="${rest%%[/?#]*}"
    [[ -n "$authority" && "$authority" != *"@"* ]] || return 1

    if [[ "$authority" == \[* ]]; then
        [[ "$authority" =~ ^\[[0-9A-Fa-f:]+\](:[0-9]{1,5})?$ ]] || return 1
        port="${authority##*]}"
        port="${port#:}"
    else
        [[ "$authority" =~ ^[A-Za-z0-9][A-Za-z0-9.-]*(:[0-9]{1,5})?$ ]] || return 1
        host="${authority%%:*}"
        [[ "$host" != .* && "$host" != *. && "$host" != *..* ]] || return 1
        port="${authority##*:}"
        [[ "$port" == "$authority" ]] && port=""
    fi

    [[ -z "$port" || ("$port" =~ ^[0-9]+$ && 10#$port -le 65535) ]]
}

slug_from_name() {
    local name="${1,,}"
    local slug=""
    local character
    local index

    for ((index = 0; index < ${#name}; index++)); do
        character="${name:index:1}"
        case "$character" in
            [a-z0-9]) slug+="$character" ;;
            [._\ -]) [[ "$slug" == *- ]] || slug+="-" ;;
        esac
    done

    slug="${slug#-}"
    slug="${slug%-}"
    valid_id "$slug" || die "Could not derive a safe ID from the name; pass --id."
    printf '%s\n' "$slug"
}

update_desktop_database() {
    recheck_storage
    command -v update-desktop-database >/dev/null 2>&1 || return 0
    update-desktop-database "$APPLICATIONS_DIR" >/dev/null 2>&1 || true
}

path_is_within_data_root() {
    [[ "$1" == "$DATA_ROOT"/* ]]
}

assert_data_root() {
    local canonical owner mode

    [[ -d "$DATA_ROOT" && ! -L "$DATA_ROOT" ]] || die "Canonical XDG data root is not a real directory: $DATA_ROOT"
    owner="$(stat -c %u -- "$DATA_ROOT")" || die "Cannot inspect XDG data root: $DATA_ROOT"
    [[ "$owner" == "$INVOKING_UID" ]] || die "XDG data root is not owned by the invoking user: $DATA_ROOT"
    mode="$(stat -c %a -- "$DATA_ROOT")" || die "Cannot inspect XDG data root permissions: $DATA_ROOT"
    (( (8#$mode & 0022) == 0 )) || die "XDG data root must not be group or other writable: $DATA_ROOT"
    canonical="$(readlink -f -- "$DATA_ROOT")" || die "Cannot recanonicalize XDG data root: $DATA_ROOT"
    [[ "$canonical" == "$DATA_ROOT" ]] || die "Canonical XDG data root changed: $DATA_ROOT"
}

assert_managed_directory() {
    local directory="$1"
    local canonical owner mode

    [[ -d "$directory" && ! -L "$directory" ]] || die "Managed directory must be a real directory: $directory"
    owner="$(stat -c %u -- "$directory")" || die "Cannot inspect managed directory: $directory"
    [[ "$owner" == "$INVOKING_UID" ]] || die "Managed directory is not owned by the invoking user: $directory"
    mode="$(stat -c %a -- "$directory")" || die "Cannot inspect managed directory permissions: $directory"
    (( (8#$mode & 0022) == 0 )) || die "Managed directory must not be group or other writable: $directory"
    if [[ "$directory" == "$CONFIG_DIR" ]]; then
        (( (8#$mode & 0077) == 0 )) || die "Managed metadata directory must be private (0700): $directory"
    fi
    canonical="$(readlink -f -- "$directory")" || die "Cannot canonicalize managed directory: $directory"
    path_is_within_data_root "$canonical" || die "Managed directory resolves outside XDG data root: $directory"
}

ensure_managed_directory() {
    local directory="$1"

    if [[ ! -e "$directory" && ! -L "$directory" ]]; then
        mkdir -m 0700 -- "$directory" || die "Cannot create managed directory: $directory"
    fi
    assert_managed_directory "$directory"
}

prepare_storage() {
    if [[ ! -e "$SELECTED_DATA_HOME" && ! -L "$SELECTED_DATA_HOME" ]]; then
        mkdir -p -m 0700 -- "$SELECTED_DATA_HOME" || die "Cannot create XDG data root: $SELECTED_DATA_HOME"
    fi
    [[ -d "$SELECTED_DATA_HOME" ]] || die "XDG data root is not a directory: $SELECTED_DATA_HOME"

    DATA_ROOT="$(readlink -f -- "$SELECTED_DATA_HOME")" || die "Cannot canonicalize XDG data root: $SELECTED_DATA_HOME"
    assert_data_root

    CONFIG_DIR="$DATA_ROOT/fedora-web-apps"
    APPLICATIONS_DIR="$DATA_ROOT/applications"
    TEMP_DIR="$DATA_ROOT/fedora-web-app-tmp"
    ensure_managed_directory "$CONFIG_DIR"
    ensure_managed_directory "$APPLICATIONS_DIR"
    ensure_managed_directory "$TEMP_DIR"
}

recheck_storage() {
    [[ -n "$DATA_ROOT" && -n "$CONFIG_DIR" && -n "$APPLICATIONS_DIR" && -n "$TEMP_DIR" ]] || die "Managed storage is not initialized."
    assert_data_root
    assert_managed_directory "$CONFIG_DIR"
    assert_managed_directory "$APPLICATIONS_DIR"
    assert_managed_directory "$TEMP_DIR"
}

assert_safe_destination() {
    local destination="$1"
    local owner

    case "$(dirname -- "$destination")" in
        "$CONFIG_DIR"|"$APPLICATIONS_DIR") ;;
        *) die "Refusing a destination outside managed storage: $destination" ;;
    esac

    if [[ -e "$destination" || -L "$destination" ]]; then
        [[ ! -L "$destination" && -f "$destination" ]] || die "Refusing symlink or non-regular destination: $destination"
        owner="$(stat -c %u -- "$destination")" || die "Cannot inspect destination: $destination"
        [[ "$owner" == "$INVOKING_UID" ]] || die "Destination is not owned by the invoking user: $destination"
    fi
}

remove_managed_file() {
    local destination="$1"

    recheck_storage
    assert_safe_destination "$destination"
    rm -f -- "$destination"
}

write_atomic() (
    local destination="$1"
    local temporary=""

    trap '[[ -z "${temporary:-}" ]] || rm -f -- "$temporary"' EXIT

    recheck_storage
    assert_safe_destination "$destination"
    temporary="$(mktemp --tmpdir="$TEMP_DIR" ".${destination##*/}.XXXXXX")" || die "Cannot create temporary file for: $destination"

    cat > "$temporary" || die "Cannot write temporary file for: $destination"

    recheck_storage
    assert_safe_destination "$destination"
    mv -fT -- "$temporary" "$destination" || die "Cannot replace destination safely: $destination"
    temporary=""
)

write_web_app() {
    local id="$1"
    local name="$2"
    local url="$3"
    local config_file
    local desktop_file
    local desktop_exec

    valid_id "$id" || die "ID must match [a-z0-9][a-z0-9-]{0,62}."
    valid_name "$name" || die "Name must be 1-63 letters, numbers, spaces, dots, underscores, or hyphens."
    valid_url "$url" || die "URL must be a well-formed HTTP(S) URL without whitespace, backslashes, or credentials."

    prepare_storage
    config_file="$CONFIG_DIR/${APP_PREFIX}${id}.tsv"
    desktop_file="$APPLICATIONS_DIR/${APP_PREFIX}${id}.desktop"
    # The bootstrap links this fixed command name into the user-local PATH.
    # Keeping path data out of Exec avoids field-code and two-stage escaping
    # hazards for otherwise valid clone paths containing %, \\, ", $, or `.
    desktop_exec="$DESKTOP_COMMAND launch --id $id"
    assert_safe_destination "$desktop_file"
    assert_safe_destination "$config_file"

    write_atomic "$desktop_file" <<EOF
[Desktop Entry]
Type=Application
Version=1.0
Name=$name
Comment=Web app for $url
Exec=$desktop_exec
Icon=chromium-browser
Terminal=false
Categories=Network;WebBrowser;
StartupNotify=true
StartupWMClass=${APP_PREFIX}${id}
X-Fedora-Web-App-Id=$id
EOF

    if command -v desktop-file-validate >/dev/null 2>&1; then
        desktop-file-validate "$desktop_file" || {
            remove_managed_file "$desktop_file"
            die "Generated desktop entry failed desktop-file-validate."
        }
    fi

    write_atomic "$config_file" <<EOF
$name	$url
EOF
    update_desktop_database
    printf 'Managed web app %q at %s\n' "$id" "$desktop_file"
}

read_web_app() {
    local id="$1"
    local config_file
    local record_name record_url extra

    valid_id "$id" || die "ID must match [a-z0-9][a-z0-9-]{0,62}."
    prepare_storage
    config_file="$CONFIG_DIR/${APP_PREFIX}${id}.tsv"
    recheck_storage
    [[ -f "$config_file" && ! -L "$config_file" ]] || die "Managed metadata must be a non-symlink regular file: $config_file"
    [[ "$(stat -c %u -- "$config_file")" == "$INVOKING_UID" ]] || die "Managed metadata is not owned by the invoking user: $config_file"
    IFS=$'\t' read -r record_name record_url extra < "$config_file" || return 1
    [[ -z "${extra:-}" ]] && valid_name "$record_name" && valid_url "$record_url" || return 1
    printf '%s\t%s\n' "$record_name" "$record_url"
}

resolve_browser() {
    local candidate resolved

    if [[ -n "${WEB_APP_BROWSER:-}" ]]; then
        if [[ "$WEB_APP_BROWSER" == */* ]]; then
            [[ -x "$WEB_APP_BROWSER" ]] || die "WEB_APP_BROWSER is not executable: $WEB_APP_BROWSER"
            printf '%s\n' "$WEB_APP_BROWSER"
            return 0
        fi
        resolved="$(command -v -- "$WEB_APP_BROWSER" || true)"
        [[ -n "$resolved" ]] || die "WEB_APP_BROWSER was not found on PATH: $WEB_APP_BROWSER"
        printf '%s\n' "$resolved"
        return 0
    fi

    for candidate in chromium-browser chromium; do
        resolved="$(command -v -- "$candidate" || true)"
        if [[ -n "$resolved" ]]; then
            printf '%s\n' "$resolved"
            return 0
        fi
    done

    die "Chromium is unavailable. Install Fedora's chromium package, then try again."
}

# Chromium gates profile access with a SingletonLock symlink whose target is
# "<hostname>-<pid>". After an unclean exit the lock survives and every later
# launch refuses to start ("profile appears to be in use"). If the lock names
# this host and its PID no longer exists, the lock is stale and can be removed;
# Chromium recreates the cookie/socket files as needed. A live PID (including a
# reused one) is never touched, and locks naming a different host are left for
# Chromium's manual "another computer" unlock flow.
recover_stale_profile_lock() {
    local profile_dir="${WEB_APP_CHROMIUM_PROFILE:-$HOME/.config/chromium}"
    local lock_path target lock_host lock_pid

    lock_path="$profile_dir/SingletonLock"
    [[ -L "$lock_path" ]] || return 0
    target="$(readlink -- "$lock_path")" || return 0
    lock_host="${target%-*}"
    lock_pid="${target##*-}"
    [[ "$lock_pid" =~ ^[0-9]+$ ]] || return 0
    [[ "$lock_host" == "$(hostname)" ]] || return 0
    if kill -0 "$lock_pid" 2>/dev/null; then
        return 0
    fi
    rm -f -- "$lock_path"
    printf 'Removed stale Chromium profile lock (dead pid %s): %s\n' \
        "$lock_pid" "$lock_path" >&2
}

launch_web_app() {
    local id="$1"
    local record name url browser

    if ! record="$(read_web_app "$id")"; then
        notify_error "Web app is not configured" "Create it with: fedora-web-app add --id $id --name NAME --url HTTPS_URL"
        return 1
    fi
    IFS=$'\t' read -r name url <<< "$record"

    if ! browser="$(resolve_browser)"; then
        notify_error "Chromium is unavailable" "Install Fedora's chromium package, then launch $name again."
        return 1
    fi

    recover_stale_profile_lock
    exec "$browser" --ozone-platform=wayland "--app=$url"
}

add_command() {
    local id=""
    local name=""
    local url=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --id)
                require_value "$1" "${2:-}"
                id="$2"
                shift 2
                ;;
            --name)
                require_value "$1" "${2:-}"
                name="$2"
                shift 2
                ;;
            --url)
                require_value "$1" "${2:-}"
                url="$2"
                shift 2
                ;;
            *) die "Unknown add option: $1" ;;
        esac
    done

    if [[ -z "$name" || -z "$url" ]]; then
        [[ -t 0 ]] || die "Noninteractive add requires --name and --url."
        [[ -n "$name" ]] || read -r -p "Web app name: " name
        [[ -n "$url" ]] || read -r -p "Website URL (https://...): " url
    fi

    [[ -n "$id" ]] || id="$(slug_from_name "$name")"
    write_web_app "$id" "$name" "$url"
}

remove_command() {
    [[ "${1:-}" == "--id" ]] || die "remove requires --id ID."
    require_value "$1" "${2:-}"
    [[ $# -eq 2 ]] || die "remove accepts only --id ID."

    local id="$2"
    valid_id "$id" || die "ID must match [a-z0-9][a-z0-9-]{0,62}."
    prepare_storage
    remove_managed_file "$CONFIG_DIR/${APP_PREFIX}${id}.tsv"
    remove_managed_file "$APPLICATIONS_DIR/${APP_PREFIX}${id}.desktop"
    update_desktop_database
    printf 'Removed managed web app %q\n' "$id"
}

list_command() {
    local config_file id record
    local found=0

    prepare_storage
    for config_file in "$CONFIG_DIR"/${APP_PREFIX}*.tsv; do
        [[ -e "$config_file" || -L "$config_file" ]] || continue
        [[ -f "$config_file" && ! -L "$config_file" ]] || \
            die "Managed metadata must be a non-symlink regular file: $config_file"
        id="${config_file##*/${APP_PREFIX}}"
        id="${id%.tsv}"
        valid_id "$id" || continue
        record="$(read_web_app "$id")" || die "Refusing invalid managed metadata: $config_file"
        printf '%s\t%s\n' "$id" "$record"
        found=1
    done
    [[ "$found" -eq 1 ]] || printf 'No managed web apps.\n'
}

case "${1:-add}" in
    add)
        shift || true
        add_command "$@"
        ;;
    preset)
        [[ "${2:-}" == "outlook" && $# -eq 2 ]] || die "Supported preset: outlook"
        write_web_app "outlook" "Outlook" "https://outlook.cloud.microsoft/mail/"
        ;;
    launch)
        [[ "${2:-}" == "--id" && $# -eq 3 ]] || die "launch requires --id ID."
        launch_web_app "$3"
        ;;
    list)
        [[ $# -eq 1 ]] || die "list does not accept arguments."
        list_command
        ;;
    remove)
        shift
        remove_command "$@"
        ;;
    --print-browser)
        [[ $# -eq 1 ]] || die "--print-browser does not accept arguments."
        resolve_browser
        ;;
    -h|--help)
        usage
        ;;
    *)
        die "Unknown command: $1"
        ;;
esac
